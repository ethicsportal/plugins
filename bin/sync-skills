#!/usr/bin/env python3
"""Copy the skills that ethicsportal.eu publishes into skills/.

    bin/sync-skills            update skills/ and bump the plugin version if anything changed
    bin/sync-skills --check    exit 1 if the copies differ from the published skills

The website is the source. Edit a skill there, then run this.
"""
import hashlib
import json
import pathlib
import shutil
import sys
import urllib.parse
import urllib.request

INDEX = "https://ethicsportal.eu/.well-known/agent-skills/index.json"
ROOT = pathlib.Path(__file__).resolve().parent.parent
SKILLS = ROOT / "skills"
# Clients keep an install on its version until the version changes.
MANIFESTS = [
    ROOT / ".claude-plugin/plugin.json",
    ROOT / ".cursor-plugin/plugin.json",
    ROOT / ".codex-plugin/plugin.json",
    ROOT / "gemini-extension.json",
]


def fetch(url):
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "ethicsportal-plugins-sync"})) as response:
        return response.read()


def published():
    skills = {}
    for entry in json.loads(fetch(INDEX))["skills"]:
        body = fetch(urllib.parse.urljoin(INDEX, entry["url"]))
        digest = "sha256:" + hashlib.sha256(body).hexdigest()
        if digest != entry["digest"]:
            sys.exit(f"{entry['name']}: the published file does not match its digest in {INDEX}")
        skills[entry["name"]] = body
    return skills


def bump_patch_version():
    for path in MANIFESTS:
        manifest = json.loads(path.read_text())
        major, minor, patch = manifest["version"].split(".")
        manifest["version"] = f"{major}.{minor}.{int(patch) + 1}"
        path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n")


def main():
    skills = published()
    local = {path.parent.name: path.read_bytes() for path in SKILLS.glob("*/SKILL.md")}
    changed = sorted(name for name in skills.keys() | local.keys() if skills.get(name) != local.get(name))

    if "--check" in sys.argv[1:]:
        if changed:
            sys.exit("Out of date: " + ", ".join(changed) + ". Run bin/sync-skills.")
        return
    if not changed:
        return

    for name in local.keys() - skills.keys():
        shutil.rmtree(SKILLS / name)
    for name, body in skills.items():
        (SKILLS / name).mkdir(parents=True, exist_ok=True)
        (SKILLS / name / "SKILL.md").write_bytes(body)
    bump_patch_version()
    print("Updated: " + ", ".join(changed))


if __name__ == "__main__":
    main()
