#!/usr/bin/env python3
"""Copy the skills that ethicsportal.eu publishes into the Claude Code plugin.

    bin/sync-skills            update plugins/ethicsportal/skills
    bin/sync-skills --check    exit 1 if the copies differ from the published skills

The website is the source. Edit a skill there, then run this.
"""
import hashlib
import json
import pathlib
import shutil
import sys
import urllib.parse
import urllib.request

INDEX = "https://ethicsportal.eu/.well-known/agent-skills/index.json"
SKILLS = pathlib.Path(__file__).resolve().parent.parent / "plugins" / "ethicsportal" / "skills"


def fetch(url):
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "ethicsportal-plugins-sync"})) as response:
        return response.read()


def published():
    skills = {}
    for entry in json.loads(fetch(INDEX))["skills"]:
        body = fetch(urllib.parse.urljoin(INDEX, entry["url"]))
        digest = "sha256:" + hashlib.sha256(body).hexdigest()
        if digest != entry["digest"]:
            sys.exit(f"{entry['name']}: the published file does not match its digest in {INDEX}")
        skills[entry["name"]] = body
    return skills


def main():
    check = "--check" in sys.argv[1:]
    skills = published()
    local = {path.parent.name: path.read_bytes() for path in SKILLS.glob("*/SKILL.md")}

    if check:
        stale = sorted(name for name in skills.keys() | local.keys() if skills.get(name) != local.get(name))
        if stale:
            sys.exit("Out of date: " + ", ".join(stale) + ". Run bin/sync-skills.")
        return

    for name in local.keys() - skills.keys():
        shutil.rmtree(SKILLS / name)
    for name, body in skills.items():
        (SKILLS / name).mkdir(parents=True, exist_ok=True)
        (SKILLS / name / "SKILL.md").write_bytes(body)


if __name__ == "__main__":
    main()
